{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "vercel-dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://raahi-radio-road.ommcodes.chatgpt.site/api/:path*"
    },
    {
      "source": "/:path((?!_vercel/).*)",
      "destination": "/index.html"
    }
  ]
}
